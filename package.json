{
  "name": "automacao-mobile",
  "version": "1.0.0",
  "description": "Framework de automacao mobile Android com WebdriverIO e Appium",
  "main": "wdio.conf.js",
  "scripts": {
    "appium": "appium --address 127.0.0.1 --port 4723",
    "doctor": "appium driver list --installed && adb devices",
    "test:android": "wdio run wdio.conf.js",
    "test:ios": "wdio run configs/ios.conf.js",
    "test:ios:checkout": "wdio run configs/ios.conf.js --spec ./tests/ios/checkout.ios.spec.js",
    "test:ios:browserstack": "wdio run configs/browserstack.ios.conf.js --spec ./tests/ios/checkout.ios.spec.js",
    "test:ios:devicefarm": "npm run test:ios:browserstack",
    "test:login": "wdio run wdio.conf.js --spec ./tests/login/login.spec.js",
    "test:forms": "wdio run wdio.conf.js --spec ./tests/forms/forms.spec.js",
    "test:swipe": "wdio run wdio.conf.js --spec ./tests/swipe/swipe.spec.js",
    "test:drag": "wdio run wdio.conf.js --spec ./tests/drag/drag.spec.js",
    "allure:generate": "npx allure-commandline generate reports/allure-results --clean -o reports/allure-report",
    "allure:open": "npx allure-commandline open reports/allure-report"
  },
  "keywords": [
    "wdio",
    "appium",
    "android",
    "automation"
  ],
  "author": "QA Automation Mobile",
  "license": "MIT",
  "devDependencies": {
    "@wdio/appium-service": "^9.18.0",
    "@wdio/allure-reporter": "^9.18.0",
    "@wdio/cli": "^9.18.0",
    "@wdio/local-runner": "^9.18.0",
    "@wdio/mocha-framework": "^9.18.0",
    "@wdio/spec-reporter": "^9.18.0",
    "allure-commandline": "^2.34.1",
    "appium": "^3.1.1",
    "appium-xcuitest-driver": "^10.5.2",
    "appium-uiautomator2-driver": "^7.2.2",
    "expect-webdriverio": "^5.4.3",
    "webdriverio": "^9.18.0"
  }
}
