# Local Appium
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723
APPIUM_PATH=/

# Local Android
ANDROID_APP_PATH=./app/android/loja-ebac.apk
LOCAL_ANDROID_DEVICE_NAME=ANDROID_EMULATOR
LOCAL_ANDROID_UDID=emulator-5554

# BrowserStack mandatory
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=
BROWSERSTACK_APP_ID=

# BrowserStack optional tuning
BROWSERSTACK_DEVICE_NAME=Samsung Galaxy S23
BROWSERSTACK_OS_VERSION=13.0
BROWSERSTACK_PROJECT_NAME=TCC EBAC QE Mobile
BROWSERSTACK_BUILD_NAME=
BROWSERSTACK_SESSION_NAME=Android smoke and regression
BROWSERSTACK_MAX_INSTANCES=1

# Test users
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
