{
  "name": "tcc-ebac-qe-mobile-automation",
  "version": "1.0.0",
  "description": "Enterprise mobile QA automation project with WebdriverIO, Appium, BrowserStack and GitHub Actions",
  "private": true,
  "main": "index.js",
  "scripts": {
    "test:android:local": "wdio run ./configs/android.conf.js",
    "test:android:cloud": "wdio run ./configs/browserstack.conf.js",
    "test:smoke:local": "wdio run ./configs/android.conf.js --suite smoke",
    "test:smoke:cloud": "wdio run ./configs/browserstack.conf.js --suite smoke",
    "test:regression:local": "wdio run ./configs/android.conf.js --suite regression",
    "test:regression:cloud": "wdio run ./configs/browserstack.conf.js --suite regression",
    "allure:generate": "allure generate ./reports/allure-results --clean -o ./reports/allure-report",
    "allure:open": "allure open ./reports/allure-report"
  },
  "keywords": [
    "qa",
    "quality-engineering",
    "mobile-automation",
    "webdriverio",
    "appium",
    "browserstack",
    "github-actions"
  ],
  "author": "QA Engineering Team",
  "license": "MIT",
  "devDependencies": {
    "@wdio/allure-reporter": "^9.18.0",
    "@wdio/cli": "^9.18.0",
    "@wdio/local-runner": "^9.18.0",
    "@wdio/mocha-framework": "^9.18.0",
    "@wdio/spec-reporter": "^9.18.0",
    "allure-commandline": "^2.34.1",
    "appium": "^3.1.1",
    "appium-uiautomator2-driver": "^7.2.2",
    "dotenv": "^16.4.5",
    "expect-webdriverio": "^5.4.3",
    "webdriverio": "^9.18.0"
  }
}
